---
permalink: /manifest.webmanifest
sitemap: false
layout: null
---
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "description": {{ site.description | strip | jsonify }},
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#F7F3EC",
  "theme_color": "#2B3A52",
  "icons": [
    { "src": "/assets/images/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/assets/images/icon-48.png", "sizes": "48x48", "type": "image/png" },
    { "src": "/assets/images/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/images/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
